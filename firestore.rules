rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isFridgeMember(fridgeId) {
      return signedIn()
             && exists(/databases/$(database)/documents/fridges/$(fridgeId)/members/$(request.auth.uid));
    }

    function isFridgeOwner(fridgeId) {
      return signedIn()
             && get(/databases/$(database)/documents/fridges/$(fridgeId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /app_settings/{settingId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    match /fridges/{fridgeId} {
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid;
      allow read: if isFridgeMember(fridgeId);
      allow update, delete: if isFridgeOwner(fridgeId);

      match /members/{memberId} {
        allow read: if isFridgeMember(fridgeId);
        allow create: if signedIn()
                      && ((memberId == request.auth.uid
                           && fridgeId == request.auth.uid
                           && request.resource.data.role == 'owner')
                          || isFridgeOwner(fridgeId));
        allow update, delete: if isFridgeOwner(fridgeId);
      }

      match /foods/{foodId} {
        allow read, write: if isFridgeMember(fridgeId);
      }
    }
  }
}
